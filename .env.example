SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Real domain(s) once assigned — required for CSRF to work over HTTPS in prod
# (see config/settings.py "Security"). Comma-separated, include scheme, e.g.:
# CSRF_TRUSTED_ORIGINS=https://garantunitedacademy.com,https://www.garantunitedacademy.com
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (project standard — see CLAUDE.md)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kyrsi

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Fondy — выдаётся после регистрации и KYB (см. CLAUDE.md, шаг 0)
FONDY_MERCHANT_ID=
FONDY_SECRET_KEY=
FONDY_PARTNER_RECEIVER_ID=

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@kyrsi.example
PARTNER_NOTIFICATION_EMAIL=partner@kyrsi.example
ACCOUNTING_EMAIL=accounting@kyrsi.example

# Telegram — исходящее уведомление партнёру (полноценный бот — шаг 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
